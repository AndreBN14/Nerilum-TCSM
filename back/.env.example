APP_ENV=development
HOST=127.0.0.1
PORT=8000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=  # Por defecto: {SUPABASE_URL}/auth/v1
JWT_LEEWAY_SECONDS=0
JWKS_CACHE_TTL_SECONDS=3600
JWKS_MIN_REFRESH_INTERVAL_SECONDS=60
JWKS_TIMEOUT_SECONDS=5
# Segundos del header Retry-After en las respuestas 503.
RETRY_AFTER_SECONDS=5
CORS_ORIGINS=[]
# DATABASE_URL=postgresql://...   # DSN PostgreSQL del backend (usa SQLite si está vacío).
# Carpeta del modelo ONNX (relativa a back/ o absoluta). Debe contener un único
# *.onnx y su model_card.json. Sin ella, model_ready=false y POST /analyses
# responde 503 model_unavailable. El nombre/versión/dataset salen del card.
MODEL_DIR=app/models
# Descarga del artefacto desde el repositorio público (scripts/download_model.py).
# MODEL_URL: por defecto, la URL del raw file en el repo público.
# MODEL_SHA256: hash esperado para verificar la integridad (opcional).
# No se necesita MODEL_TOKEN ni GITHUB_TOKEN (repositorio público).
# MODEL_URL=
# MODEL_SHA256=
MODEL_INPUT_SIZE=224
# center_crop reproduce el pipeline de inferencia de Ultralytics YOLOv8-cls
# (Resize del lado corto + CenterCrop). Los argumentos exactos del entrenamiento
# no están disponibles: la equivalencia completa aún no está demostrada.
MODEL_RESIZE_MODE=center_crop
# El ONNX de este artefacto ya devuelve probabilidades normalizadas (softmax
# integrado). Dejar en false; activar solo si el modelo devolviera logits.
MODEL_SOFTMAX=false
# Límites de imágenes subidas.
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_DIMENSION=4096
MAX_IMAGE_PIXELS=16777216
# Semilla de demostración (solo desarrollo, idempotente, is_demo=true).
SEED_DEMO=false
SEED_DEMO_ACCOUNT_ID=

# DATABASE_URL para Supabase Postgres
# Usar Connection Pooler (Transaction mode) con SSL. Ejemplo ficticio (no usar credenciales reales):
# postgresql://user:password@db.XXXXXXXX.supabase.co:6543/postgres?sslmode=require
DATABASE_URL=

# Compartido por todas las instancias FastAPI. Generar un valor aleatorio
# de al menos 32 caracteres para habilitar /analyses/preview y /analyses/save.
# No compartirlo con Flutter ni incluirlo en Git.
ANALYSIS_PROOF_SECRET=
# Credencial privilegiada del servidor para el bucket privado analysis-images.
# Configurar solo en Render/entorno local privado; nunca en Flutter ni en Git.
SUPABASE_SERVICE_ROLE_KEY=
ANALYSIS_IMAGES_BUCKET=analysis-images
